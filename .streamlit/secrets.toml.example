# CurriculumIQ — Streamlit secrets TEMPLATE (placeholders only).
#
# LOCAL:   copy to `.streamlit/secrets.toml` and fill in your key, OR use a
#          `.env` file instead (either works — see README).
# DEPLOYED (Streamlit Community Cloud): paste these keys into the app's
#          "Secrets" box in the dashboard. Streamlit also exposes top-level
#          secrets as environment variables, which is how the app reads them.
#
# NEVER commit a real secrets.toml — it is git-ignored.

OPENAI_API_KEY = ""
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
OPENAI_CHAT_MODEL = "gpt-4o-mini"

# Public-demo cost protection (recommended for a public deployment):
# Cap tutor questions per session (0 = unlimited).
MAX_QUESTIONS_PER_SESSION = "20"
# Shared access code required to use the deployed app. Set a real value here in
# the Streamlit Cloud "Secrets" box (NEVER commit it). Empty = open access.
APP_ACCESS_CODE = ""

# Optional overrides (defaults shown in README):
# MAX_FILE_SIZE_MB = "15"
# MAX_PAGE_COUNT = "300"
# RAG_TOP_K = "5"
# RAG_MAX_DISTANCE = "0.7"
