# Copy to .env and fill in values. Never commit your real .env.
# PDF extraction & chunking work without a key; indexing and search need one.

# --- OpenAI (required for indexing & semantic search) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval / RAG config (optional; sensible defaults shown) ---
# CHROMA_PERSIST_DIRECTORY=.curriculumiq_data/chroma
# CHROMA_COLLECTION_NAME=curriculumiq
# RAG_CHUNK_SIZE_TOKENS=700
# RAG_CHUNK_OVERLAP_TOKENS=100
# RAG_TOP_K=5
# RAG_MAX_TOP_K=20

# --- Ingestion limits (optional) ---
# MAX_FILE_SIZE_MB=15
# MAX_PAGE_COUNT=300
# MIN_CHARS_PER_PAGE=3

# --- Public-demo cost protection (optional) ---
# Cap tutor questions per browser session (0 = unlimited). Protects a public
# deployment from unbounded API cost.
# MAX_QUESTIONS_PER_SESSION=20
# Shared access code gating the app. Leave empty/unset for open local dev.
# Set a value on a public deployment to require it. NEVER commit a real value.
# APP_ACCESS_CODE=
